# Build config defaults
# To get a debug build define DEBUG in local.mak
#DEBUG=debug
CARGO=cargo

# Build config overrides
!IF EXISTS(local.mak)
!include .\local.mak
!ENDIF

# Define build target and flags
# --target=x86_64-win7-windows-msvc
!IFDEF DEBUG
TARGET_DIR=target\$(RUST_PLATFORM)\debug
CARGOFLAGS=--target=$(RUST_PLATFORM)
!ELSE
TARGET_DIR=target\$(RUST_PLATFORM)\release
CARGOFLAGS=--release --target=$(RUST_PLATFORM)
!ENDIF
TARGET=$(TARGET_DIR)\pep_engine_sequoia_backend.dll

build:
	IF EXIST target RD /s /q target
	$(CARGO) rustc $(CARGOFLAGS) -- -L$(OUTPUT)
	@echo Built $(TARGET)
	XCOPY /Y $(TARGET_DIR)\pep_engine_sequoia_backend* $(OUTPUT)\

clean:
	IF EXIST target RD /s /q target
